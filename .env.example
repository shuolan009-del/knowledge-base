# ====================
# Model Source & Cache
# ====================
# Hugging Face 缓存路径（local-onnx 模式首次运行会自动下载模型到此目录）
HF_HOME=D:/ai_models/huggingface_cache
# 国内服务器 HuggingFace 直连超时/被墙时，取消下一行注释改用镜像：
# HF_ENDPOINT=https://hf-mirror.com
# 临时文件根目录
MD_ROOT_DIR=./temp-files/

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API 基础地址（阿里云 DashScope）
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认 LLM 模型
LLM_DEFAULT_MODEL=qwen-flash
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型
VL_MODEL=qwen3-vl-flash
# 商品名识别模型
ITEM_MODEL=qwen-flash

# ====================
# Embedding（三档模式，核心开关）
# ====================
# local-gpu  : BGE-M3 本地推理，dense+sparse 双向量（需 uv sync --extra gpu）
# local-onnx : fastembed ONNX CPU 推理，仅 dense（默认，服务器友好）
# api        : DashScope text-embedding API，仅 dense（内存最省，按量计费）
EMBED_MODE=local-onnx
# 向量维度：留空则按模式取默认值（local-gpu=1024 / local-onnx=512 / api=1536）
# 若显式填写，必须与实际模型输出维度一致，否则建表/检索会因维度不符报错
EMBEDDING_DIM=
# ---- local-onnx 模式专用 ----
# fastembed 模型名（中文检索推荐 bge-small-zh-v1.5）
EMBEDDING_ONNX_MODEL=BAAI/bge-small-zh-v1.5
# ---- api 模式专用（复用 OPENAI_API_KEY，无需单独密钥）----
EMBEDDING_MODEL=text-embedding-v4
# ---- local-gpu 模式专用 ----
# BGE-M3 模型本地路径
BGE_M3_PATH=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
# BGE-M3 模型名称（仅记录）
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备（cpu / cuda:0）
BGE_DEVICE=cpu
# 是否使用半精度（True/False）
BGE_FP16=True

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址：
#   - 服务器/单机轻量部署：./milvus.db（Milvus Lite 嵌入式，无需 docker/etcd/minio，数据即单文件）
#   - 独立 Milvus 服务：http://<ip>:19530
# ⚠️ 切换 embedding 模式会改变向量维度与语义空间，旧集合需换名重建：
#    改 CHUNKS_COLLECTION / ITEM_NAME_COLLECTION 为新集合名（或手动 drop 旧集合）。
MILVUS_URL=./milvus.db
# 知识库切片集合名
CHUNKS_COLLECTION=kb_chunks
# 商品名称集合名
ITEM_NAME_COLLECTION=kb_item_names
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# History (SQLite，原 MongoDB 轻量替代)
# ====================
# 会话历史库文件路径（零中间件，数据即单文件，建议加入备份清单）
HISTORY_DB_PATH=./data/history.db

# ====================
# Object Storage (本地目录，原 MinIO 轻量替代)
# ====================
# 本地存储根目录（图片/备份；API 挂载 /storage 静态路由）
STORAGE_LOCAL_DIR=./storage
# 图片在存储内的子目录
STORAGE_IMG_DIR=images
# 图片对外 URL 前缀：默认相对路径（前后端同源时可直接用）；
# 跨域/域名场景改为绝对地址，如 http://<服务器IP>:8000/storage
STORAGE_URL_BASE=/storage

# ====================
# Other / MCP Services
# ====================
# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
# MCP API Key（同时用于 DashScope rerank）
MCP_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# rerank 模型名称
TEXT_RERANK_MODEL=gte-rerank
# rerank 指令（为空则不使用指令）
TEXT_RERANK_INSTRUCT=
# 上传文件落地根目录
DATA_BASED_ROOT_DIR=./data/files
