.env
.venv

# ===== 本地/敏感/无关文件，不纳入版本控制 =====
# 真实密钥与运行配置（模板 .env.example 保留）
.env
# JetBrains / IDE 配置
.idea/
# Python 缓存与字节码
__pycache__/
*.pyc
*.pyo
*.pyd
# 本地日志与运行时产物
*.log
logs/

# WorkBuddy 本地记忆与配置（非项目代码）
.workbuddy/

# AI 工具自动安装的通用 skill 与个人配置（非本项目代码）
.agents/skills/
.claude/
# AI 工具配置（.codex 含真实 API Key，绝不入库）
.codex/
# MinIO 二进制 105MB（超 GitHub 100MB 单文件限制，改为 Dockerfile 内下载）
docker/minio-build/minio

# ===== 零中间件栈运行时产物（不入库）=====
# SQLite 会话历史 + 上传文件（HISTORY_DB_PATH / DATA_BASED_ROOT_DIR）
data/
# 本地文件存储（STORAGE_LOCAL_DIR）
storage/
# Milvus Lite 嵌入式库（注意：是目录，不是单文件；MILVUS_URL=./milvus.db）
milvus.db/
milvus.db
milvus_lite.db/
# fastembed / huggingface 模型缓存
.fastembed_cache/
.cache/huggingface/
